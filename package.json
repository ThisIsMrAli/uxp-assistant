{
  "name": "uxp-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UXP Assistant plans, scaffolds, and implements a UXP plugin with a loopback dashboard. A build is not a host pass.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "create-bolt-uxp": "1.3.27"
  },
  "scripts": {
    "test": "node --test",
    "assist": "node .claude/skills/uxp-assistant/scripts/assist.mjs",
    "session": "node .claude/skills/uxp-assistant/scripts/session.mjs",
    "dashboard": "node .claude/skills/uxp-assistant/scripts/dashboard.mjs",
    "refresh": "node .claude/skills/uxp-assistant/scripts/refresh-docs.mjs",
    "link-agents": "node install-agents.mjs",
    "acceptance": "UXP_ASSISTANT_ACCEPTANCE=1 node --test test/acceptance.test.mjs"
  }
}
